\newlabel{fig:hb_sweep}{{2}{5}{Relación entre intervalo de transmisión, PDR, colisiones, consumo diario y vida útil estimada. A mayor intervalo: menor carga del canal, mayor PDR y mayor vida útil}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Energía y modelo solar}{5}{subsection.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Balance energético solar vs.\ consumo por SF (escala log). Para SF7–SF9 la cosecha solar supera el consumo por un factor $> 10$. Solo SF12 es solar-inviable con un panel pequeño.}}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:solar}{{3}{6}{Balance energético solar vs.\ consumo por SF (escala log). Para SF7–SF9 la cosecha solar supera el consumo por un factor $> 10$. Solo SF12 es solar-inviable con un panel pequeño}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Desglose analítico de energía diaria por estado del nodo. En SF7, el 84\,\% del consumo corresponde a TX y solo el 16\,\% a sleep. En SF12 el tiempo en TX es tan elevado que domina completamente.}}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:energy_breakdown}{{4}{7}{Desglose analítico de energía diaria por estado del nodo. En SF7, el 84\,\% del consumo corresponde a TX y solo el 16\,\% a sleep. En SF12 el tiempo en TX es tan elevado que domina completamente}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Distribución del consumo por nodo en 1 hora de simulación. SF7 ($\sigma = 0.018$\,J, CV = 6.2\,\%) muestra alta uniformidad entre nodos, lo que facilita el dimensionamiento homogéneo del sistema. SF12 presenta mayor dispersión ($\sigma = 0.417$\,J) por los patrones de colisión dependientes de la posición.}}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:energy_dist}{{5}{7}{Distribución del consumo por nodo en 1 hora de simulación. SF7 ($\sigma = 0.018$\,J, CV = 6.2\,\%) muestra alta uniformidad entre nodos, lo que facilita el dimensionamiento homogéneo del sistema. SF12 presenta mayor dispersión ($\sigma = 0.417$\,J) por los patrones de colisión dependientes de la posición}{figure.caption.11}{}}

\newlabel{fig:lifetime_all}{{7}{9}{Vida útil estimada para los 14 escenarios: batería nueva (día 0), EOL comercial 80\,\% (día 500) y año 5 (día 1\,825). La configuración SF7/1\,200\,s supera los 12 años con batería nueva}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Análisis de la Escalabilidad}{9}{section.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Escalabilidad: PDR, colisiones y energía vs.\ densidad de nodos (SF7, 1 GW, 300\,s heartbeat).}}{9}{table.caption.15}\protected@file@percent }
\newlabel{tab:scalability}{{7}{9}{Escalabilidad: PDR, colisiones y energía vs.\ densidad de nodos (SF7, 1 GW, 300\,s heartbeat)}{table.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Escalabilidad de la red LoRa raw. PDR y colisión varían linealmente con la densidad. La energía por nodo es completamente invariante: cada nodo consume lo mismo independientemente de cuántos vecinos tenga.}}{10}{figure.caption.16}\protected@file@percent }
\newlabel{fig:scalability}{{8}{10}{Escalabilidad de la red LoRa raw. PDR y colisión varían linealmente con la densidad. La energía por nodo es completamente invariante: cada nodo consume lo mismo independientemente de cuántos vecinos tenga}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Mapa de calor de vida útil estimada (días) en función del SF y el intervalo heartbeat. La región verde (SF7, heartbeat $\geq 600$\,s) supera los 3\,000 días. Cualquier combinación con SF $\geq 10$ cae en zona roja incluso con heartbeat de 300\,s.}}{11}{figure.caption.17}\protected@file@percent }
\newlabel{fig:heatmap}{{9}{11}{Mapa de calor de vida útil estimada (días) en función del SF y el intervalo heartbeat. La región verde (SF7, heartbeat $\geq 600$\,s) supera los 3\,000 días. Cualquier combinación con SF $\geq 10$ cae en zona roja incluso con heartbeat de 300\,s}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Comparación de PDR en los tres barridos principales. El heartbeat y el SF son los factores de mayor impacto; la densidad de nodos tiene un efecto secundario.}}{11}{figure.caption.18}\protected@file@percent }
\newlabel{fig:pdr_comparison}{{10}{11}{Comparación de PDR en los tres barridos principales. El heartbeat y el SF son los factores de mayor impacto; la densidad de nodos tiene un efecto secundario}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Tabla resumen visual de los 14 escenarios, coloreados por PDR. Verde: PDR $\geq 90$\,\%, Amarillo: 70--90\,\%, Rojo: $<70$\,\%.}}{12}{figure.caption.19}\protected@file@percent }
\newlabel{fig:summary_table}{{11}{12}{Tabla resumen visual de los 14 escenarios, coloreados por PDR. Verde: PDR $\geq 90$\,\%, Amarillo: 70--90\,\%, Rojo: $<70$\,\%}{figure.caption.19}{}}
